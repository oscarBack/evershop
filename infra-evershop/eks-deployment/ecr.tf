# ECR Repositories for EverShop

# ECR Repository for GraphQL API
resource "aws_ecr_repository" "graphql_api" {
  name                 = "${var.project_name}-graphql-api"
  image_tag_mutability = "MUTABLE"

  image_scanning_configuration {
    scan_on_push = true
  }

  encryption_configuration {
    encryption_type = "AES256"
  }

  tags = merge(
    var.common_tags,
    {
      Name        = "${var.project_name}-graphql-api"
      Environment = var.environment
      Component   = "graphql-api"
    }
  )
}

# ECR Repository for React Frontend
resource "aws_ecr_repository" "react_frontend" {
  name                 = "${var.project_name}-react-frontend"
  image_tag_mutability = "MUTABLE"

  image_scanning_configuration {
    scan_on_push = true
  }

  encryption_configuration {
    encryption_type = "AES256"
  }

  tags = merge(
    var.common_tags,
    {
      Name        = "${var.project_name}-react-frontend"
      Environment = var.environment
      Component   = "react-frontend"
    }
  )
}

# Lifecycle Policy for GraphQL API Repository
resource "aws_ecr_lifecycle_policy" "graphql_api" {
  repository = aws_ecr_repository.graphql_api.name

  policy = jsonencode({
    rules = [
      {
        rulePriority = 1
        description  = "Keep last 10 images"
        selection = {
          tagStatus     = "tagged"
          tagPrefixList = ["v"]
          countType     = "imageCountMoreThan"
          countNumber   = 10
        }
        action = {
          type = "expire"
        }
      },
      {
        rulePriority = 2
        description  = "Remove untagged images after 7 days"
        selection = {
          tagStatus   = "untagged"
          countType   = "sinceImagePushed"
          countUnit   = "days"
          countNumber = 7
        }
        action = {
          type = "expire"
        }
      }
    ]
  })
}

